# Конфигурационные файлы для Zumba Site
# Скопируйте этот файл в config/ и заполните актуальными значениями

# Telegram Bot Token (получить у @BotFather)
# Пример: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
telegram_token.txt=ВАШ_TELEGRAM_BOT_TOKEN

# Telegram Chat ID (получить у @userinfobot)
# Пример: 123456789
telegram_chat_id.txt=ВАШ_CHAT_ID

# URL CRM системы для отправки лидов
# Пример: https://crm.example.com/api/leads
# Оставьте пустым, если CRM не используется
crm_url.txt=https://crm.example.com/api/leads

# --- ИНСТРУКЦИЯ ---
# 1. Создайте директорию config/ в корне сайта:
#    mkdir config
#
# 2. Создайте файлы с конфигурацией:
#    echo "ВАШ_ТОКЕН" > config/telegram_token.txt
#    echo "ВАШ_CHAT_ID" > config/telegram_chat_id.txt
#    echo "https://crm.example.com/api/leads" > config/crm_url.txt
#
# 3. Добавьте config/.gitignore для защиты чувствительных данных:
#    echo "*" > config/.gitignore
#    echo "!telegram_token.txt" >> config/.gitignore
#    echo "!telegram_chat_id.txt" >> config/.gitignore
#    echo "!crm_url.txt" >> config/.gitignore
#
# 4. Проверьте права доступа на сервере:
#    chmod 600 config/*.txt
#    chown www-data:www-data config/*.txt
